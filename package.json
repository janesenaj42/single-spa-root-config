{
  "name": "single-spa-root-config",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "single-spa root config that registers microfrontends from YAML config files",
  "scripts": {
    "build:js": "node build.js",
    "build:config": "node scripts/build-mfe-config.js",
    "build:keycloak-config": "node scripts/build-keycloak-config.js",
    "build": "npm run build:js && npm run build:config",
    "serve": "npx http-server dist -p 8080 -c-1",
    "test": "node --test test/",
    "lint": "eslint .",
    "prepare": "husky || true",
    "release": "commit-and-tag-version"
  },
  "dependencies": {
    "single-spa": "^6.0.1",
    "js-yaml": "^4.1.0",
    "ajv": "^8.17.1",
    "keycloak-js": "^25.0.6"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "eslint": "^9.15.0",
    "@eslint/js": "^9.15.0",
    "globals": "^15.12.0",
    "husky": "^9.1.7",
    "@commitlint/cli": "^19.6.0",
    "@commitlint/config-conventional": "^19.6.0",
    "commit-and-tag-version": "^12.5.0"
  }
}
